#!/usr/bin/env bash
# omnicode-doctor — deep health check for the omnicode multi-model orchestration system.
#
#   omnicode-doctor            full token-free check (CLIs, auth, router, lanes, uib,
#                              brain, agents, skills, MCP, state) with functional probes
#   omnicode-doctor --fast     skip the slower auth probes and the uib browser probe
#   omnicode-doctor --live     ALSO run one tiny real prompt through the top healthy
#                              code lane (burns a little quota — proves end-to-end)
#   omnicode-doctor --record   write ~/.omnicode/doctor-last.txt + append history line
#
# Exit 0 = no FAIL. Exit 1 = at least one FAIL.
set -uo pipefail
H="$HOME"
# launchd starts with a thin PATH. Every owned CLI is under ~/.local/bin and
# Grok keeps its binary under ~/.grok/bin; add deterministic system locations.
export PATH="$H/.local/bin:$H/.grok/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"
FAST=0; LIVE=0; RECORD=0
for a in "$@"; do case "$a" in --fast) FAST=1;; --live) LIVE=1;; --record) RECORD=1;; esac; done

PASS=0; WARN=0; FAIL=0
OUT=""
say()  { OUT+="$1"$'\n'; echo "$1"; }
pass() { PASS=$((PASS+1)); say "[PASS] $*"; }
warn() { WARN=$((WARN+1)); say "[WARN] $*"; }
fail() { FAIL=$((FAIL+1)); say "[FAIL] $*"; }
sect() { say ""; say "== $* =="; }
to()   { perl -e 'alarm shift; exec @ARGV' "$@" 2>&1; }   # to <sec> <cmd...>

say "omnicode-doctor — $(date '+%Y-%m-%d %H:%M') — host $(hostname -s)"

# ---------------------------------------------------------------- core binaries
sect "core binaries"
for b in tmux node python3 npx uvx gh git claude; do
  if command -v "$b" >/dev/null 2>&1; then pass "$b on PATH"; else fail "$b missing from PATH"; fi
done

# ---------------------------------------------------------------- lane CLIs + auth
sect "lane CLIs + subscription auth (token-free probes)"
if command -v codex >/dev/null 2>&1; then
  if [ "$FAST" = 1 ]; then pass "codex installed (auth probe skipped --fast)"
  elif to 15 env -u OPENAI_API_KEY codex login status >/dev/null; then pass "codex installed + ChatGPT auth OK"
  else fail "codex auth probe failed — run: codex login"; fi
else fail "codex CLI missing"; fi

if command -v grok >/dev/null 2>&1; then
  if [ "$FAST" = 1 ]; then pass "grok installed (auth probe skipped --fast)"
  elif to 15 grok models >/dev/null; then pass "grok installed + xAI auth OK"
  else fail "grok auth probe failed — run: grok login"; fi
else fail "grok CLI missing"; fi

if [ -x "$H/.local/bin/glm" ] && [ -r "$H/.config/zai/token" ]; then pass "glm launcher + z.ai token present"
else fail "glm launcher or ~/.config/zai/token missing"; fi

if command -v dcode >/dev/null 2>&1; then
  if [ "$FAST" = 1 ]; then pass "dcode installed (auth probe skipped --fast)"
  elif to 25 env -u OPENAI_API_KEY -u OPENAI_BASE_URL dcode auth list | grep -qE "openai_codex\s+stored"; then
    pass "dcode installed + openai_codex auth stored"
  else fail "dcode openai_codex auth not stored — run: dcode auth set openai_codex"; fi
else fail "dcode CLI missing"; fi

# ---------------------------------------------------------------- fallback router
sect "fallback router (lane-pick + ladders)"
if [ -x "$H/.local/bin/lane-pick" ]; then pass "lane-pick executable"; else fail "lane-pick missing"; fi
if python3 -c "import json;json.load(open('$H/.claude/omnicode/ladders.json'))" 2>/dev/null; then
  pass "ladders.json valid JSON"
else fail "ladders.json missing or invalid JSON"; fi
if python3 -c "
import json;d=json.load(open('$H/.claude/omnicode/ladders.json'))
g=d.get('quota_groups',{}).get('openai',[])
assert 'codex' in g and 'dcode' in g" 2>/dev/null; then
  pass "quota group openai contains codex+dcode"
else fail "quota_groups.openai must contain codex and dcode"; fi
if python3 -c "
import json; m=json.load(open('$H/.claude/omnicode/models.json'))
assert m['claude']['architecture_advisor']['resolved']=='claude-fable-5'
assert m['claude']['rjv_implementer']['resolved']=='claude-opus-5'
assert m['codex']['model']=='gpt-5.6-sol' and m['codex']['context_window']==272000 and m['codex']['reasoning_effort']=='max'
assert m['grok']['model']=='grok-4.6' and m['grok']['context_window']==500000 and m['grok']['routine_reasoning_effort']=='high' and m['grok']['rjv_reasoning_effort']=='xhigh'
assert m['glm']['resolved']=='glm-5.3[1m]' and m['glm']['context_window']==1000000 and m['glm']['reasoning_effort']=='max'
assert m['dcode']['model']=='openai_codex:gpt-5.6-sol'" 2>/dev/null; then
  pass "models.json matches the latest model/context/effort policy"
else fail "models.json missing, invalid, or stale"; fi
for c in code correctness langchain longcontext research review ui architecture; do
  r=$(lane-pick "$c" 2>/dev/null); rc=$?
  if [ $rc -eq 0 ]; then pass "class $c -> $r"
  elif [ $rc -eq 3 ]; then warn "class $c: NO healthy lane right now (ladder exhausted)"
  else fail "class $c: lane-pick error rc=$rc"; fi
done

# ---------------------------------------------------------------- lanes runner
sect "lanes runner (tmux + auto-scan integration)"
if [ -x "$H/.local/bin/lanes" ]; then pass "lanes executable"; else fail "lanes missing"; fi
if grep -qE 'scan.*lane-pick|lane-pick.*scan' "$H/.local/bin/lanes" 2>/dev/null; then
  pass "lanes carries the rate-limit auto-scan hook"
else fail "lanes is missing the lane-pick scan hook (fallback auto-detection dead)"; fi
if [ -w "$H/.lanes" ] || mkdir -p "$H/.lanes" 2>/dev/null; then pass "~/.lanes writable"; else fail "~/.lanes not writable"; fi
MARK="omnicode-selftest-$$"
S=$(lanes start doctor-selftest -- echo "$MARK" 2>/dev/null | awk -F= '/^SESSION=/{print $2}')
if [ -n "$S" ] && lanes wait "$S" 30 >/dev/null 2>&1 && grep -q "$MARK" "$H/.lanes/$S.log" 2>/dev/null; then
  pass "lanes success round-trip (start->wait->log) works"
else fail "lanes success round-trip failed (session=$S)"; fi
FAIL_S=$(lanes start doctor-failure -- sh -c 'exit 7' 2>/dev/null | awk -F= '/^SESSION=/{print $2}')
lanes wait "$FAIL_S" 30 >/dev/null 2>&1; FAIL_WAIT=$?
lanes result "$FAIL_S" >/dev/null 2>&1; FAIL_RESULT=$?
if [ "$FAIL_WAIT" -eq 7 ] && [ "$FAIL_RESULT" -eq 7 ]; then
  pass "lanes propagates and persists vendor failure exit codes"
else fail "lanes masked failure exit (wait=$FAIL_WAIT result=$FAIL_RESULT session=$FAIL_S)"; fi

# ---------------------------------------------------------------- uib browser
sect "uib browser (UI verification loop)"
if [ -x "$H/.local/bin/uib" ] && [ -f "$H/.uib/uib.mjs" ]; then pass "uib shim + implementation present"; else fail "uib missing"; fi
if [ -d "$H/.uib/node_modules/playwright" ]; then pass "playwright installed in ~/.uib"; else fail "playwright missing — cd ~/.uib && npm i"; fi
if [ "$FAST" = 1 ]; then
  warn "uib browser probe skipped (--fast)"
else
  if uib status >/dev/null 2>&1; then
    PNG=$(mktemp -t uib-doctor.XXXXXX).png
    if uib shot "$PNG" >/dev/null 2>&1 && [ "$(wc -c < "$PNG" 2>/dev/null || echo 0)" -gt 1000 ]; then
      pass "uib daemon already live — non-destructive screenshot OK (left running)"
    else warn "uib daemon live but screenshot failed"; fi
  else
    PNG=$(mktemp -t uib-doctor.XXXXXX).png
    if uib open 'data:text/html,<title>doctor</title><h1>omnicode doctor</h1>' >/dev/null 2>&1 \
       && uib shot "$PNG" >/dev/null 2>&1 \
       && [ "$(wc -c < "$PNG" 2>/dev/null || echo 0)" -gt 1000 ]; then
      uib stop >/dev/null 2>&1
      pass "uib full round-trip (open->shot->stop) works, offline-safe data: URL"
    else
      uib stop >/dev/null 2>&1
      fail "uib round-trip failed"
    fi
  fi
fi

# ---------------------------------------------------------------- shared brain + memory
sect "shared brain + doctrine coherence"
CANON=$(python3 -c "import os;print(os.path.realpath(os.path.expanduser('~/.ai-memory/MEMORY.md')))" 2>/dev/null)
if [ -n "$CANON" ] && [ -f "$CANON" ]; then pass "brain file exists ($CANON)"; else fail "~/.ai-memory/MEMORY.md unresolvable"; fi
DRIFT=0
for f in "$H/.codex/AGENTS.md" "$H/.grok/AGENTS.md"; do
  R=$(python3 -c "import os;print(os.path.realpath('$f'))" 2>/dev/null)
  if [ "$R" = "$CANON" ]; then pass "brain link OK: $f"
  else DRIFT=1; fail "brain link DRIFT: $f -> $R (expected $CANON)"; fi
done
[ $DRIFT -eq 0 ] && pass "all vendor CLIs read the SAME brain"
DOC="$H/.ai-memory/multi-model-orchestration.md"
if grep -q "Automatic fallback ladders" "$DOC" 2>/dev/null && grep -q "uib" "$DOC" 2>/dev/null; then
  pass "doctrine carries fallback + uib sections"
else fail "doctrine missing fallback/uib sections ($DOC)"; fi
if grep -q "lane-pick" "$CANON" 2>/dev/null; then pass "shared brain mentions lane-pick (lanes will discover the router)"
else fail "shared brain does not mention lane-pick"; fi

# ---------------------------------------------------------------- wrapper agents
sect "lane wrapper agents"
for a in fable-advisor codex-implementer grok-implementer glm-longcontext dcode-implementer; do
  [ -f "$H/.claude/agents/$a.md" ] && pass "agent $a present" || fail "agent $a.md missing"
done
for a in codex-implementer grok-implementer glm-longcontext dcode-implementer; do
  grep -q "Rate-limit fallback" "$H/.claude/agents/$a.md" 2>/dev/null \
    && pass "$a carries fallback protocol" || fail "$a missing fallback protocol"
done
if [ -e "$H/.claude/agents/antigravity-implementer.md" ] || [ -e "$H/.claude/agents/gemini-reviewer.md" ]; then
  fail "retired Gemini/Antigravity wrapper still installed — run scripts/apply.sh"
else pass "retired Gemini/Antigravity wrappers absent"; fi
# Match only a BARE invocation line (the bug); prose warnings quoting the pattern are fine.
if grep -qE -- '^[[:space:]]*- < "\$SPEC"[[:space:]]*\\?$' "$H/.claude/agents/codex-implementer.md" 2>/dev/null; then
  fail "codex-implementer still documents the stdin-redirect invocation (hangs under lanes)"
else pass "codex-implementer stdin bug absent"; fi
if grep -q 'grok-4.6' "$H/.claude/agents/grok-implementer.md" 2>/dev/null \
   && grep -q -- '--reasoning-effort high' "$H/.claude/agents/grok-implementer.md" 2>/dev/null \
   && ! grep -qE -- '-m[[:space:]]+grok-4\.5' "$H/.claude/agents/grok-implementer.md" 2>/dev/null; then
  pass "Grok wrapper pins 4.6 with high reasoning"
else fail "Grok wrapper model/effort pin is stale"; fi
if grep -q '^model: fable$' "$H/.claude/agents/fable-advisor.md" 2>/dev/null; then
  pass "Fable advisor is pinned to the latest Fable alias"
else fail "fable-advisor does not actually select Fable"; fi

# ---------------------------------------------------------------- skills / MCP / workflows
sect "skills, MCP, workflows"
[ -f "$H/.claude/workflows/race-and-judge.mjs" ] && pass "race-and-judge workflow present" || fail "race-and-judge.mjs missing"
if grep -q -- '- < "$SPEC"' "$H/.claude/workflows/race-and-judge.mjs" 2>/dev/null; then
  fail "race-and-judge reintroduces the Codex stdin hang"
else pass "race-and-judge Codex prompt is positional"; fi
if grep -qiE 'antigravity|gemini|\bagy\b' "$H/.claude/workflows/race-and-judge.mjs" 2>/dev/null; then
  fail "race-and-judge still routes a retired Gemini/Antigravity lane"
else pass "race-and-judge has no Gemini/Antigravity lane"; fi
if grep -q 'grok-4.6' "$H/.claude/workflows/race-and-judge.mjs" 2>/dev/null \
   && grep -q -- '--reasoning-effort xhigh' "$H/.claude/workflows/race-and-judge.mjs" 2>/dev/null \
   && grep -q "model: 'fable'" "$H/.claude/workflows/race-and-judge.mjs" 2>/dev/null; then
  pass "RJV uses Grok 4.6 xhigh and a Fable judge"
else fail "RJV model/effort policy is stale"; fi
if grep -qE 'stash or reset them|git stash|reset --hard|stash -u' "$H/.agents/skills/omnicode/SKILL.md" 2>/dev/null; then
  fail "omnicode skill contains destructive fallback cleanup guidance"
else pass "omnicode skill bans destructive fallback cleanup"; fi
if [ -L "$H/.agents/skills" ] \
   && [ "$(realpath "$H/.agents/skills" 2>/dev/null)" = "$(realpath "$H/.claude/skills" 2>/dev/null)" ]; then
  pass "shared agent skills root safely points to Claude skills"
else fail "~/.agents/skills must remain a symlink to ~/.claude/skills"; fi
if [ "$(readlink "$H/.agents/skills/omnicode" 2>/dev/null)" = "$H/Projects/omnicode/skill" ] \
   && [ "$(readlink "$H/.claude/skills/omnicode" 2>/dev/null)" = "$H/Projects/omnicode/skill" ] \
   && [ -f "$H/.agents/skills/omnicode/SKILL.md" ] \
   && [ -f "$H/.claude/skills/omnicode/SKILL.md" ]; then
  pass "omnicode skill symlinked into shared + Claude roots"
else fail "omnicode skill symlink missing/wrong — run scripts/apply.sh"; fi
if [ -f "$H/.claude/skills/rjv/SKILL.md" ]; then
  pass "rjv skill present"
  if grep -qiE '\bagy\b|grok 4\.5|gemini 3\.1|antigravity-implementer' "$H/.claude/skills/rjv/SKILL.md"; then
    fail "rjv skill advertises a retired/stale model"
  elif grep -q 'Grok 4.6' "$H/.claude/skills/rjv/SKILL.md" \
       && grep -q 'Fable 5' "$H/.claude/skills/rjv/SKILL.md"; then
    pass "rjv skill matches the current model policy"
  else fail "rjv skill is missing current Grok/Fable routing"; fi
else warn "rjv skill missing"; fi
if grok models 2>/dev/null | grep -q 'Default model: grok-4.6'; then
  pass "authenticated Grok catalog defaults to 4.6"
else fail "authenticated Grok catalog does not default to 4.6"; fi
if grep -q 'default = "grok-4.6"' "$H/.grok/config.toml" 2>/dev/null \
   && grep -q 'fork_secondary_model = "grok-4.6"' "$H/.grok/config.toml" 2>/dev/null; then
  pass "Grok local defaults are pinned to 4.6"
else fail "~/.grok/config.toml still pins an older Grok model"; fi
if grep -q 'ANTHROPIC_DEFAULT_OPUS_MODEL="glm-5.3\[1m\]"' "$H/.local/bin/glm" 2>/dev/null \
   && grep -q 'MAX_THINKING_TOKENS="64000"' "$H/.local/bin/glm" 2>/dev/null; then
  pass "GLM launcher maps the 1M flagship and max reasoning budget"
else fail "GLM launcher model/context/reasoning mapping is stale"; fi
if python3 -c "
import json,os
p=os.path.expanduser('~/.codex/models_cache.json'); m=json.load(open(p))['models'][0]
assert m['slug']=='gpt-5.6-sol' and m['max_context_window']==272000
assert any(x['effort']=='max' for x in m['supported_reasoning_levels'])" 2>/dev/null; then
  pass "authenticated Codex catalog confirms GPT-5.6-Sol / 272K / max"
else warn "Codex model cache does not confirm the pinned subscription model"; fi
if python3 -c "
import json;d=json.load(open('$H/.claude.json'))
assert 'agent-harnesses' in d.get('mcpServers',{})" 2>/dev/null; then
  pass "agent-harnesses MCP configured"
else warn "agent-harnesses MCP not in ~/.claude.json"; fi

# ---------------------------------------------------------------- goal ledger
sect "goal ledger (durable cross-harness goals)"
if [ -x "$H/.local/bin/goal" ]; then pass "goal CLI executable"; else fail "goal CLI missing"; fi
GS="doctor-probe-$$"
if goal new "$GS" --objective "doctor functional probe" --acceptance "true" --cwd /tmp >/dev/null 2>&1 \
   && goal loop "$GS" 2>/dev/null | grep -q "DONE"; then
  pass "goal round-trip (new->loop->DONE on green acceptance) works"
else fail "goal round-trip failed"; fi
rm -f "$H/.omnicode/goals/$GS.json" "$H/.omnicode/goals/$GS.events.jsonl"
BADG=0
for gj in "$H"/.omnicode/goals/*.json; do
  [ -e "$gj" ] || continue
  python3 -c "import json;json.load(open('$gj'))" 2>/dev/null || { BADG=1; fail "corrupt goal file: $gj"; }
done
[ $BADG -eq 0 ] && pass "all goal files parse"
OPEN=$(goal list 2>/dev/null | grep -c '^open' || true)
say "       open goals: ${OPEN:-0}"

# ---------------------------------------------------------------- repo self-tests
sect "repo self-tests"
REPO="$H/Projects/omnicode"
if [ -f "$REPO/tests/test_lane_pick.py" ]; then
  if python3 "$REPO/tests/test_lane_pick.py" >/dev/null 2>&1; then
    pass "omnicode unit tests pass"
  else
    fail "omnicode unit tests fail — run: python3 $REPO/tests/test_lane_pick.py"
  fi
else
  warn "repo tests unavailable at $REPO"
fi

# ---------------------------------------------------------------- state hygiene
sect "state hygiene"
if python3 -c "import json;json.load(open('$H/.lanes/health.json'))" 2>/dev/null; then
  pass "health.json valid"; COOL=$(lane-pick status 2>/dev/null | grep COOLDOWN || true)
  [ -n "$COOL" ] && say "$COOL"
else warn "health.json missing/invalid (fresh state is fine)"; fi
if [ -f "$H/.uib/daemon.json" ]; then
  DPID=$(python3 -c "import json;print(json.load(open('$H/.uib/daemon.json')).get('pid',0))" 2>/dev/null || echo 0)
  if [ "$DPID" -gt 0 ] && kill -0 "$DPID" 2>/dev/null; then say "       uib daemon live (pid $DPID) — fine"
  else warn "stale ~/.uib/daemon.json (daemon dead) — uib will clean it on next start"; fi
fi
SZ=$(du -sm "$H/.lanes" 2>/dev/null | cut -f1 || echo 0)
if [ "${SZ:-0}" -gt 200 ]; then warn "~/.lanes is ${SZ}MB — prune old logs"; else pass "~/.lanes size OK (${SZ}MB)"; fi
OLD=$(tmux ls 2>/dev/null | grep '^lane-' | grep -cv "$(date +%m%d)" || true)
[ "${OLD:-0}" -gt 0 ] && warn "$OLD lane tmux session(s) from a previous day still running — check: tmux ls" || pass "no stale lane sessions"

# ---------------------------------------------------------------- optional live probe
if [ "$LIVE" = 1 ]; then
  sect "LIVE end-to-end probe (burns a little quota)"
  L=$(lane-pick code 2>/dev/null || true)
  case "$L" in
    grok)  CMD=(grok -p "Reply with exactly: OMNICODE-LIVE-OK" -m grok-4.6 --reasoning-effort low --output-format plain);;
    glm)   CMD=(glm --model sonnet -p "Reply with exactly: OMNICODE-LIVE-OK");;
    codex) CMD=(codex exec --ignore-user-config -m gpt-5.6-sol -c model_reasoning_effort=low -s read-only --skip-git-repo-check "Reply with exactly: OMNICODE-LIVE-OK");;
    *)     CMD=();;
  esac
  if [ ${#CMD[@]} -gt 0 ]; then
    S=$(lanes start doctor-live -- "${CMD[@]}" | awk -F= '/^SESSION=/{print $2}')
    lanes wait "$S" 120 >/dev/null 2>&1 || true
    if grep -q "OMNICODE-LIVE-OK" "$H/.lanes/$S.log" 2>/dev/null; then
      pass "live prompt through $L lane returned correctly"
    else fail "live probe through $L did not return the marker (see ~/.lanes/$S.log)"; fi
  else warn "no healthy code lane for live probe"; fi
fi

# ---------------------------------------------------------------- summary
sect "summary"
say "PASS=$PASS WARN=$WARN FAIL=$FAIL"
if [ "$RECORD" = 1 ]; then
  mkdir -p "$H/.omnicode"
  printf '%s' "$OUT" > "$H/.omnicode/doctor-last.txt"
  echo "$(date '+%Y-%m-%d %H:%M') PASS=$PASS WARN=$WARN FAIL=$FAIL" >> "$H/.omnicode/doctor-history.log"
fi
[ "$FAIL" -eq 0 ]
