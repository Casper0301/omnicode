#!/usr/bin/env bash
# lanes — run omnicode CLI lanes (codex/grok/glm/dcode) in named tmux sessions:
# watchable live, log-backed, completion-signaled, with the vendor exit code persisted.
#
#   lanes start <name> -- <command...>   launch detached; prints SESSION= and LOG=
#   lanes wait <session> [max-sec=540]   0 = vendor success; 142 = still running; other = failed
#   lanes result <session>               replay the recorded vendor exit code
#   lanes ls                             list running lane sessions + recent logs
#   lanes peek <session> [n=25]          last n lines of the live pane (falls back to the log)
#   lanes log <session> [n=40]           tail the lane's log file
#   lanes attach <session>               attach a real terminal to the lane (detach: Ctrl-b d)
#   lanes kill <session>                 kill a lane session
set -uo pipefail
DIR="$HOME/.lanes"; mkdir -p "$DIR"
GUARD_DIR="$DIR/guard"
mkdir -p "$GUARD_DIR/gh-config-empty"
touch "$GUARD_DIR/gitconfig"
chmod 600 "$GUARD_DIR/gitconfig"
sub="${1:-ls}"; shift || true

recorded_result() {
  local sess="$1" rcfile="$DIR/$1.rc" donefile="$DIR/$1.done" rc
  if [ ! -f "$donefile" ]; then
    tmux has-session -t "$sess" 2>/dev/null && return 142
    echo "lanes: session ended without a completion record: $sess" >&2
    return 4
  fi
  if [ ! -r "$rcfile" ]; then
    echo "lanes: completion record exists but exit code is missing: $sess" >&2
    return 4
  fi
  rc=$(cat "$rcfile")
  if [[ ! "$rc" =~ ^[0-9]+$ ]] || [ "$rc" -gt 255 ]; then
    echo "lanes: invalid recorded exit code for $sess: $rc" >&2
    return 4
  fi
  if [ "$rc" -eq 142 ]; then
    # 142 is reserved by `lanes wait` for "still running". A completed
    # perl-alarm timeout also exits 142, so expose it as the conventional 124.
    echo "[lanes] result=142 (completed alarm timeout; returning 124)"
    return 124
  fi
  echo "[lanes] result=$rc"
  return "$rc"
}

case "$sub" in
  start)
    name="$1"; shift
    [ "${1:-}" = "--" ] && shift
    sess="lane-${name}-$(date +%m%d-%H%M%S)-$$-${RANDOM}"
    log="$DIR/$sess.log"
    runner="$DIR/$sess.cmd"
    rcfile="$DIR/$sess.rc"
    donefile="$DIR/$sess.done"
    # Detect the external vendor so quota/rate-limit failures update lane-pick.
    vend=$(printf '%s ' "$@" | grep -oE '\b(codex|grok|glm|dcode|claude)\b' | head -1 || true)
    {
      printf '#!/usr/bin/env bash\n'
      # No set -e here: the result files and wait-for signal must land on failure.
      if [ "${OMNICODE_NO_GITHUB:-0}" = "1" ]; then
        guard_home="${AUTORADAR_AGENT_HOME:?AUTORADAR_AGENT_HOME is required in guarded mode}"
        printf 'env -i'
        for key in HOME LANG LC_ALL LC_CTYPE LOGNAME PATH SHELL TERM TMPDIR USER; do
          value="${!key:-}"
          [ -n "$value" ] && printf ' %q' "$key=$value"
        done
        printf ' %q' \
          "GH_CONFIG_DIR=$guard_home/gh-config-empty" \
          "XDG_CONFIG_HOME=$guard_home/xdg-config" \
          "GIT_CONFIG_GLOBAL=$guard_home/gitconfig" \
          "GIT_CONFIG_SYSTEM=/dev/null" \
          "GIT_CONFIG_COUNT=1" \
          "GIT_CONFIG_KEY_0=credential.helper" \
          "GIT_CONFIG_VALUE_0=" \
          "GIT_ASKPASS=/usr/bin/false" \
          "GIT_SSH_COMMAND=/usr/bin/false" \
          "GIT_TERMINAL_PROMPT=0" \
          "GH_PAGER=cat" \
          "GIT_PAGER=cat" \
          "PAGER=cat" \
          "OMNICODE_NO_GITHUB=1" \
          "AUTORADAR_AGENT_HOME=$guard_home"
        printf ' '
      else
        # Subscription lanes must never inherit pay-per-token API keys or GitHub auth.
        printf '%s' 'env -u OPENAI_API_KEY -u OPENAI_BASE_URL -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL -u OPENROUTER_API_KEY -u GEMINI_API_KEY -u GOOGLE_API_KEY -u XAI_API_KEY -u XAI_BASE_URL -u ZAI_API_KEY -u DEEPSEEK_API_KEY -u MISTRAL_API_KEY -u GROQ_API_KEY -u COHERE_API_KEY -u TOGETHER_API_KEY -u FIREWORKS_API_KEY -u LANGSMITH_API_KEY -u LANGCHAIN_API_KEY -u LANGCHAIN_TRACING_V2 -u TAVILY_API_KEY -u GH_TOKEN -u GITHUB_TOKEN -u GITHUB_PERSONAL_ACCESS_TOKEN -u GITLAB_TOKEN -u SSH_AUTH_SOCK'
        printf ' %q' \
          "GH_CONFIG_DIR=$GUARD_DIR/gh-config-empty" \
          "XDG_CONFIG_HOME=$GUARD_DIR/xdg-config" \
          "GIT_CONFIG_GLOBAL=$GUARD_DIR/gitconfig" \
          "GIT_CONFIG_SYSTEM=/dev/null" \
          "GIT_CONFIG_COUNT=1" \
          "GIT_CONFIG_KEY_0=credential.helper" \
          "GIT_CONFIG_VALUE_0=" \
          "GIT_ASKPASS=/usr/bin/false" \
          "GIT_SSH_COMMAND=/usr/bin/false" \
          "GIT_TERMINAL_PROMPT=0" \
          "GCM_INTERACTIVE=Never" \
          "GH_PAGER=cat" \
          "GIT_PAGER=cat" \
          "PAGER=cat"
        printf ' '
      fi
      printf '%q ' "$@"; printf ' 2>&1 | tee %q\n' "$log"
      printf 'rc=${PIPESTATUS[0]}\n'
      printf 'printf "%%s\\n" "$rc" > %q\n' "$rcfile.tmp"
      printf 'mv %q %q\n' "$rcfile.tmp" "$rcfile"
      printf 'echo "[lanes] exit=$rc" | tee -a %q\n' "$log"
      # Mark quota failures before signalling waiters so fallback sees fresh state.
      [ -n "$vend" ] && printf '%q scan %q %q 2>&1 | tee -a %q\n' "$HOME/.local/bin/lane-pick" "$vend" "$log" "$log"
      printf 'touch %q\n' "$donefile"
      printf 'tmux wait-for -S %q\n' "done-$sess"
      printf 'exit "$rc"\n'
    } > "$runner"
    chmod +x "$runner"
    tmux new-session -d -s "$sess" -c "$PWD" "$runner"
    echo "SESSION=$sess"
    echo "LOG=$log"
    echo "watch live: tmux attach -t $sess   (detach: Ctrl-b d)"
    ;;
  wait)
    sess="$1"; max="${2:-540}"
    if [ -f "$DIR/$sess.done" ]; then
      recorded_result "$sess"; exit $?
    fi
    if ! tmux has-session -t "$sess" 2>/dev/null; then
      echo "lanes: session is gone and no completion record exists: $sess" >&2
      exit 4
    fi
    if perl -e 'alarm shift; exec @ARGV' "$max" tmux wait-for "done-$sess" 2>/dev/null; then
      recorded_result "$sess"; exit $?
    else
      wait_rc=$?
      if [ -f "$DIR/$sess.done" ]; then
        recorded_result "$sess"; exit $?
      fi
      [ "$wait_rc" -eq 142 ] && exit 142
      echo "lanes: wait failed without a completion record: $sess" >&2
      exit 4
    fi
    ;;
  result)
    recorded_result "$1"; exit $?
    ;;
  ls)
    tmux ls 2>/dev/null | grep '^lane-' || echo "no lanes running"
    echo "--- recent logs ---"
    ls -t "$DIR"/*.log 2>/dev/null | head -5 || true
    ;;
  peek)
    tmux capture-pane -pt "$1" 2>/dev/null | tail -n "${2:-25}" || tail -n "${2:-25}" "$DIR/$1.log"
    ;;
  log)
    tail -n "${2:-40}" "$DIR/$1.log"
    ;;
  attach)
    exec tmux attach -t "$1"
    ;;
  kill)
    tmux kill-session -t "$1"
    ;;
  *)
    echo "usage: lanes start <name> -- <cmd...> | wait <sess> [max] | result <sess> | ls | peek <sess> [n] | log <sess> [n] | attach <sess> | kill <sess>"
    exit 2
    ;;
esac
